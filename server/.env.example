# TeamFlow 配置模板（server/.env）
#
# 复制成 server/.env 即可生效（.env 已被 .gitignore 忽略）：
#     cp server/.env.example server/.env     # Windows: copy server\.env.example server\.env
#
# 规则：
#   * 系统环境变量优先，已存在的变量不会被这里覆盖；要强制覆盖设 TEAMFLOW_ENV_OVERRIDE=1
#   * 值里有空格用引号包起来
#   * 用别的文件名：python server/main.py --env-file prod.env  或  TEAMFLOW_ENV_FILE=prod.env
#   * 这个文件可能含密钥，别提交进 git

# ---------------------------------------------------------------- 数据库
# 优先级：TEAMFLOW_DB_URL > DATABASE_URL > TMT_DB（只写路径也行）
# TEAMFLOW_DB_URL=sqlite:///D:/Projects/TeamFlow.dev/server/data.db
# TEAMFLOW_DB_URL=postgresql://teamflow:secret@127.0.0.1:5432/teamflow
# TEAMFLOW_DB_URL=mysql://teamflow:secret@127.0.0.1:3306/teamflow

# SQLite 自动备份：0 关闭；默认保留 20 份、最多每 10 分钟一次
# TEAMFLOW_BACKUP=1
# TEAMFLOW_BACKUP_DIR=./backups

# 首次启动是否写入演示数据（演示账号 linwei / chenmo / suxiao / zhouyuan，密码 demo1234）
# TEAMFLOW_SEED=1

# ---------------------------------------------------------------- 安全
# Cookie 的 Secure 标记：留空按请求协议判断；反向代理没传 X-Forwarded-Proto 时显式写 1
# TEAMFLOW_COOKIE_SECURE=
# HSTS：反向代理误报 https 导致浏览器打不开时设 0
# TEAMFLOW_HSTS=1

# ---------------------------------------------------------------- 头像文件
# 头像落盘目录，默认 server/data/avatars
# TEAMFLOW_AVATAR_DIR=./data/avatars

# ---------------------------------------------------------------- AI（日程截图导入）
# AI 接口地址 / 模型 / 密钥存在数据库里，登录后在「设置 → 推理引擎」里填，不需要环境变量。

# ---------------------------------------------------------------- 推理引擎（多智能体进度推断）
# 总开关：0 时整块关闭（不建引擎目录、不加载 orchify、端侧连接会被拒绝）
# TEAMFLOW_ENGINE=1

# 引擎运行数据目录（事件 JSONL、检查点、runs.db、向量库），默认 server/data/engine
# TEAMFLOW_ENGINE_DIR=./data/engine

# 团队配置的运维兜底（优先级高于「设置 → 推理引擎」里填的值）
# TEAMFLOW_ENGINE_BASE_URL=https://api.deepseek.com/v1
# TEAMFLOW_ENGINE_MODEL=deepseek-chat
# TEAMFLOW_ENGINE_API_KEY=sk-...

# 团队密钥的加密主密钥：不配也能用（降级为明文存储并在设置页提示），
# 配了就用于 Fernet 加密 api_key / 集成凭据。生成：python -c "import secrets;print(secrets.token_urlsafe(32))"
# TEAMFLOW_SECRET_KEY=

# 推理作业 worker：0 时不启动后台轮询，改由 POST /api/teams/{slug}/engine/jobs/drain 手动驱动（测试用）
# TEAMFLOW_INFERENCE_WORKER=1

# orchify 的进程级默认值由引擎层补齐（一般不用改）：
#   ORCHIFY_APPROVAL_TIMEOUT=3600   审批超时（orchify 默认无限等待）
#   ORCHIFY_RUN_STORE=sqlite:///... run 索引落盘位置

